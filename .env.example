# Supabase connection. Copy to .env.local and fill in.
# Use only the project URL and the public (publishable / anon) key here.
# Never put the service key or the database password in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local development only. true = open every screen without signing in (sample data).
# Leave unset in any deployed build.
# VITE_DEMO_OPEN=true
